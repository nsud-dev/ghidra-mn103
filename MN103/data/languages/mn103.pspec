<processor_spec>
  <programcounter register="pc"/>
  <context_data>
    <context_set space="ram">
      <set name="phase" val="0"/>
      <set name="ctx_entry" val="0"/>
    </context_set>
  </context_data>
  <register_data>
    <register name="contextreg" hidden="true"/>
    <register name="lir" group="loop"/>
    <register name="lar" group="loop"/>
  </register_data>
</processor_spec>
