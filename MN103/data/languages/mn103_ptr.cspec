<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <!-- Same as mn103.cspec except the default prototype: a0/a1 are pointer-class entries (metatype="ptr", listed
       first because Ghidra requires entries ordered by storage class), so a typed prototype puts pointer arguments
       in a0/a1 and integers in d0/d1 the way the Olympus (cc103) code passes them, e.g. memcpy(a0 dst, a1 src, d0 len),
       memset(a0 dst, d0 byte, d1 len), and pointer results come back in a0. Parameters the decompiler discovers on
       its own are listed pointers first. Select it at import as compiler "ptrregs". -->
  <data_organization>
    <absolute_max_alignment value="0" />
    <machine_alignment value="4" />
    <default_alignment value="1" />
    <default_pointer_alignment value="4" />
    <pointer_size value="4" />
    <short_size value="2" />
    <integer_size value="4" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" />
    <long_double_size value="8" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="2" />
      <entry size="4" alignment="4" />
      <entry size="8" alignment="4" />
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram" growth="negative"/>
  <returnaddress>
    <register name="mdr"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4" metatype="ptr"><register name="a0"/></pentry>
        <pentry minsize="1" maxsize="4" metatype="ptr"><register name="a1"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="d0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="d1"/></pentry>
        <pentry minsize="1" maxsize="500" align="4"><addr offset="4" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4" metatype="ptr"><register name="a0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="d0"/></pentry>
      </output>
      <unaffected>
        <register name="d2"/><register name="d3"/><register name="a2"/><register name="a3"/>
        <register name="sp"/>
        <register name="r4"/><register name="r5"/><register name="r6"/><register name="r7"/>
      </unaffected>
      <killedbycall>
        <register name="d0"/><register name="d1"/><register name="a0"/><register name="a1"/>
        <register name="mdr"/>
      </killedbycall>
    </prototype>
  </default_proto>
    <!-- Variadic calls (2026-11-08): the named register params are exactly these registers (stock takes them,
         csrc/data/variadic.csv), everything else (fmt and the values after it) goes on the stack from (4,sp).
         MN103StockCallArgs gives each variadic function the model for its registers. -->
    <prototype name="__va_none" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="500" align="4"><addr offset="4" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="d0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="a0"/></pentry>
      </output>
      <unaffected>
        <register name="d2"/><register name="d3"/><register name="a2"/><register name="a3"/>
        <register name="sp"/>
        <register name="r4"/><register name="r5"/><register name="r6"/><register name="r7"/>
      </unaffected>
      <killedbycall>
        <register name="d0"/><register name="d1"/><register name="a0"/><register name="a1"/>
        <register name="mdr"/>
      </killedbycall>
    </prototype>
    <prototype name="__va_d0" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="d0"/></pentry>
        <pentry minsize="1" maxsize="500" align="4"><addr offset="4" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="d0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="a0"/></pentry>
      </output>
      <unaffected>
        <register name="d2"/><register name="d3"/><register name="a2"/><register name="a3"/>
        <register name="sp"/>
        <register name="r4"/><register name="r5"/><register name="r6"/><register name="r7"/>
      </unaffected>
      <killedbycall>
        <register name="d0"/><register name="d1"/><register name="a0"/><register name="a1"/>
        <register name="mdr"/>
      </killedbycall>
    </prototype>
    <prototype name="__va_d1" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="d1"/></pentry>
        <pentry minsize="1" maxsize="500" align="4"><addr offset="4" space="stack"/></pentry>
